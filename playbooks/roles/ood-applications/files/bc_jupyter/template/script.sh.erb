#!/usr/bin/env bash
THIS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

<%- if OodAppkit.clusters[context.cluster].job_config[:adapter] == 'pbspro' -%>
    <%- if context.container_mounts != "" -%>    
        export CONTAINER_MOUNTS="<%= context.container_mounts %>"
        $THIS_DIR/start_container.sh $CONTAINER_NAME "$CONTAINER_MOUNTS"
    <%- else -%>
        $THIS_DIR/start_container.sh $CONTAINER_NAME
    <%- end -%>
<%- else -%>
$THIS_DIR/start_jupyter.sh
<%- end -%>